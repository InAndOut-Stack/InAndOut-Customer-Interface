{
  "name": "inandout-customer-interface",
  "description": "A web client interface that allows users to choose a store, manage a shopping list, and view TSP results",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "InAndOut-API-Modelling/build/typescript-client/typescript-codegen"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run smithy",
    "clean": "rm -r ./dist ./node_modules",
    "lint": "eslint .",
    "preview": "vite preview",
    "smithy": "npm run smithy:generate && npm run smithy:build",
    "smithy:generate": "cd ./InAndOut-API-Modelling && smithy build --projection typescript-client",
    "smithy:build": "cd ./InAndOut-API-Modelling/build/typescript-client/typescript-codegen && npm i && npm run build",
    "smithy:clean": "cd ./InAndOut-API-Modelling && smithy clean"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "framer-motion": "^12.23.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@inandout/client": "^0.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
